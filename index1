/* ---------- IMAGE BACKGROUND BLENDING ---------- */
/* Soft, seamless artwork presentation */
.art-image,
.gallery-image,
.image-card img,
.artwork img,
.upload-image,
img.art-photo {
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
  border:0 !important;
  outline:0 !important;
  border-radius:14px;
  opacity:.94;
  mix-blend-mode:normal;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 68%, rgba(0,0,0,.88) 80%, transparent 100%);
  mask-image:radial-gradient(ellipse at center, #000 68%, rgba(0,0,0,.88) 80%, transparent 100%);
  box-shadow:0 0 45px 20px rgba(28,26,34,.72);
  transition:opacity .3s ease, filter .3s ease, transform .3s ease;
}

.art-image:hover,
.gallery-image:hover,
.image-card img:hover,
.artwork img:hover,
.upload-image:hover,
img.art-photo:hover {
  opacity:1;
  filter:saturate(1.02) contrast(1.01);
}

/* Image containers fade into the page instead of showing hard rectangular edges */
.image-card,
.artwork,
.gallery-image-wrap,
.art-image-wrap,
.upload-image-wrap {
  overflow:hidden;
  border:0 !important;
  background:
    radial-gradient(ellipse at center,
      rgba(38,32,41,.15) 0%,
      rgba(28,26,34,.72) 72%,
      rgba(28,26,34,1) 100%);
  box-shadow:none !important;
}

/* Remove harsh gallery/card outlines around photographs */
.gallery-grid .image-card,
.gallery-grid figure,
.gallery-item,
.art-card {
  border:0 !important;
  outline:0 !important;
  background:transparent !important;
}

/* Gentle edge fade over dark site background */
.image-card::after,
.artwork::after,
.gallery-image-wrap::after,
.art-image-wrap::after {
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(ellipse at center,
      transparent 58%,
      rgba(28,26,34,.18) 75%,
      rgba(28,26,34,.68) 100%);
  mix-blend-mode:multiply;
}

/* Keep actual image above the soft overlay */
.image-card,
.artwork,
.gallery-image-wrap,
.art-image-wrap { position:relative; }
.image-card img,
.artwork img,
.gallery-image-wrap img,
.art-image-wrap img { position:relative; z-index:1; }

